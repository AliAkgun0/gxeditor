<Window x:Class="GalaXako.Editor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GalaXako Editor" Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{StaticResource Brush.Background}">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="20,0" FontSize="15">
                    <Run Text="GalaXako" FontWeight="SemiBold" /><Run Text=" Editor" Foreground="{StaticResource Brush.Text.Secondary}" />
                </TextBlock>
                <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46" Height="47" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding MinimizeCommand}" ToolTip="Küçült"><TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="11" /></Button>
                    <Button Width="46" Height="47" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding MaximizeCommand}" ToolTip="Büyüt / Geri yükle"><TextBlock Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="11" /></Button>
                    <Button Width="46" Height="47" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding CloseCommand}" ToolTip="Kapat"><TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11" /></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="10,12,10,12">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" HorizontalContentAlignment="Stretch" Padding="12,9" Margin="0,2">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#211F2B" /><Setter Property="BorderBrush" Value="#393545" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" FontSize="16" Width="30" Foreground="{StaticResource Brush.Text.Secondary}" /><TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="8,12,8,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="GalaXako Editor" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="v1.0.0" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" VerticalAlignment="Center" /></Grid>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding CurrentPage}" />
                <Border Panel.ZIndex="10" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="520" Margin="24"
                        Background="#F21A1722" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="10" Padding="14,12"
                        Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Warning}" FontSize="16" Margin="0,1,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding NotificationMessage}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" AutomationProperties.Name="Bildirimi kapat"
                                Command="{Binding DismissNotificationCommand}" Background="Transparent" BorderThickness="0" Padding="8,4" MinHeight="0" Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
