<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>GalaXako.Editor.App</AssemblyName>
    <RootNamespace>GalaXako.Editor.App</RootNamespace>
    <ApplicationIcon>Assets\GalaXakoEditor.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GalaXakoEditor.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\GalaXako.Editor.Core\GalaXako.Editor.Core.csproj" />
    <ProjectReference Include="..\src\GalaXako.Editor.Infrastructure\GalaXako.Editor.Infrastructure.csproj" />
  </ItemGroup>

</Project>
