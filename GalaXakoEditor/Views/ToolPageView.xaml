<UserControl x:Class="GalaXako.Editor.App.Views.ToolPageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" /><TextBlock Text="{Binding Description}" Style="{StaticResource PageSubtitle}" /></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="10" Background="#282039"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Primary.Soft}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="Giriş dosyası" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" /><TextBlock Text="{Binding InputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InputPath}" Margin="0,4,0,0" /></StackPanel><TextBlock Grid.Column="2" Text="Yerel işlem" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" /></Grid></Border>

        <Border Grid.Row="4" Style="{StaticResource Card}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#211B2E" BorderBrush="#3B2F5C" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="{Binding}" Foreground="{StaticResource Brush.Primary.Soft}" FontSize="12" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsClean}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Temizleme seçenekleri" FontWeight="SemiBold" Margin="0,0,0,8" /><WrapPanel><CheckBox Content="Boşlukları kırp" IsChecked="{Binding TrimWhitespace}" Margin="0,0,18,0" /><CheckBox Content="Boş satırları kaldır" IsChecked="{Binding RemoveEmptyLines}" Margin="0,0,18,0" /><CheckBox Content="Boşlukları normalleştir" IsChecked="{Binding NormalizeWhitespace}" Margin="0,0,18,0" /><CheckBox Content="Tekrarları kaldır" IsChecked="{Binding RemoveDuplicates}" /></WrapPanel><WrapPanel Margin="0,10,0,0"><TextBlock Text="En az uzunluk" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,6,0" /><TextBox Width="80" Text="{Binding MinimumLength}" Margin="0,0,12,0" /><TextBlock Text="En fazla" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,6,0" /><TextBox Width="80" Text="{Binding MaximumLength}" Margin="0,0,12,0" /><TextBlock Text="Harf dönüşümü" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,6,0" /><ComboBox Width="180" ItemsSource="{Binding CaseTransforms}" SelectedItem="{Binding CaseTransform}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" /></WrapPanel>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsFilter}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <DockPanel Margin="0,0,0,8"><TextBlock Text="Filtre kuralları" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Content="Kural ekle" Command="{Binding AddRuleCommand}" DockPanel.Dock="Right" /></DockPanel>
                    <ComboBox Width="210" HorizontalAlignment="Left" ItemsSource="{Binding FilterLogics}" SelectedItem="{Binding FilterLogic}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding FilterRules}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding DataContext.FilterConditions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Condition}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" /><TextBox Grid.Column="2" Text="{Binding SecondValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="İkinci değer" /><CheckBox Grid.Column="3" Content="Büyük/küçük" IsChecked="{Binding CaseSensitive}" Margin="0,0,8,0" VerticalAlignment="Center" /><Button Grid.Column="4" Content="Kaldır" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsExtract}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Ayıklayıcı" FontWeight="SemiBold" Margin="0,0,0,8" /><StackPanel Orientation="Horizontal"><ComboBox Width="220" ItemsSource="{Binding ExtractorKinds}" SelectedItem="{Binding ExtractorKind}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" Margin="0,0,8,0" /><TextBox Width="360" Text="{Binding CustomRegex, UpdateSourceTrigger=PropertyChanged}" ToolTip="Özel regex seçildiğinde desen" /></StackPanel><WrapPanel Margin="0,10,0,0"><CheckBox Content="Benzersiz sonuçlar" IsChecked="{Binding ExtractUnique}" Margin="0,0,18,0" /><CheckBox Content="Sonuçları sırala" IsChecked="{Binding ExtractSort}" Margin="0,0,18,0" /><CheckBox Content="Büyük/küçük duyarlı" IsChecked="{Binding ExtractCaseSensitive}" Margin="0,0,18,0" /><CheckBox Content="CSV çıktı" IsChecked="{Binding ExtractCsv}" /></WrapPanel>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSort}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Sıralama modu" FontWeight="SemiBold" Margin="0,0,0,8" /><ComboBox Width="260" HorizontalAlignment="Left" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" />
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDelimiter}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Ayraç ve sütun işlemi" FontWeight="SemiBold" Margin="0,0,0,8" /><WrapPanel><TextBlock Text="Ayraç" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,6,0" /><TextBox Width="80" Text="{Binding Delimiter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" ToolTip="TAB için TAB yazın" /><ComboBox Width="230" ItemsSource="{Binding DelimiterOperationKinds}" SelectedItem="{Binding DelimiterOperation}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" Margin="0,0,12,0" /><TextBlock Text="Sütun" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,6,0" /><TextBox Width="70" Text="{Binding DelimiterColumn, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" /><TextBlock Text="Sütunlar" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,6,0" /><TextBox Width="120" Text="{Binding DelimiterColumns, UpdateSourceTrigger=PropertyChanged}" ToolTip="Örn. 2,0,1" Margin="0,0,12,0" /><TextBlock Text="Birleştirici" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,6,0" /><TextBox Width="80" Text="{Binding JoinWith}" /></WrapPanel>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSplitMerge}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="Böl" FontWeight="SemiBold" Margin="0,0,0,8" /><WrapPanel><ComboBox Width="240" ItemsSource="{Binding SplitModes}" SelectedItem="{Binding SplitMode}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" Margin="0,0,8,0" /><TextBox Width="160" Text="{Binding SplitValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="Satır veya bayt değeri" /><TextBox Width="300" Text="{Binding SplitRegex, UpdateSourceTrigger=PropertyChanged}" ToolTip="Regex ile bölme deseni" /></WrapPanel><Separator Background="{StaticResource Brush.Border}" Margin="0,16" /><DockPanel><StackPanel><TextBlock Text="Birleştir" FontWeight="SemiBold" /><TextBlock Text="Dosya seçildiğinde çalışma düğmesi birleştirme işlemini başlatır." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><Button Content="Dosyaları Seç" Command="{Binding ChooseFilesCommand}" DockPanel.Dock="Right" /></DockPanel><ItemsControl ItemsSource="{Binding MergeFiles}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Foreground="{StaticResource Brush.Text.Secondary}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsCompare}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="İkinci dosya" FontWeight="SemiBold" Margin="0,0,0,8" /><DockPanel><Button Content="Dosya Seç" Command="{Binding ChooseSecondFileCommand}" DockPanel.Dock="Right" /><StackPanel Orientation="Horizontal"><ComboBox Width="200" ItemsSource="{Binding CompareModes}" SelectedItem="{Binding CompareMode}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" Margin="0,0,12,0" /><TextBlock Text="{Binding SecondFilePath, TargetNullValue=Henüz seçilmedi}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecondFilePath}" Foreground="{StaticResource Brush.Text.Secondary}" /></StackPanel></DockPanel>
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsPipeline}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <DockPanel Margin="0,0,0,8"><TextBox Width="220" Text="{Binding PipelineName}" DockPanel.Dock="Left" /><Button Content="Adım ekle" Command="{Binding AddPipelineStepCommand}" DockPanel.Dock="Right" /></DockPanel><ItemsControl ItemsSource="{Binding PipelineSteps}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding DataContext.PipelineStepTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Type}" ItemTemplate="{StaticResource EnumComboBoxItemTemplate}" /><Button Grid.Column="1" Content="↑" Command="{Binding DataContext.MovePipelineStepUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" /><Button Grid.Column="2" Content="↓" Command="{Binding DataContext.MovePipelineStepDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" /><Button Grid.Column="3" Content="Kaldır" Command="{Binding DataContext.RemovePipelineStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8,0,0,0" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,8,0,0"><Button Content="Pipeline Kaydet" Command="{Binding SavePipelineCommand}" Margin="0,0,8,0" /><Button Content="Presetleri Yenile" Command="{Binding LoadPipelinesCommand}" Margin="0,0,8,0" /><ComboBox Width="220" ItemsSource="{Binding SavedPipelines}" SelectedItem="{Binding SelectedPipeline}" DisplayMemberPath="Name" /></WrapPanel><Separator Background="{StaticResource Brush.Border}" Margin="0,16" /><DockPanel><StackPanel><TextBlock Text="Batch işleme" FontWeight="SemiBold" /><TextBlock Text="Seçilen dosyalara bu pipeline'ı sınırlı eşzamanlılıkla uygular." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Dosyaları Seç" Command="{Binding ChooseBatchFilesCommand}" Margin="0,0,8,0" /><Button Content="Batch Çalıştır" Command="{Binding RunBatchCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel></DockPanel><TextBlock Text="{Binding BatchFiles.Count, StringFormat={}{0:N0} dosya seçildi}" Foreground="{StaticResource Brush.Primary.Soft}" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasInput}" Value="True" /><Condition Binding="{Binding SupportsPreview}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Önce · örnek" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox Text="{Binding PreviewBefore, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Sonra · örnek" FontWeight="SemiBold" Margin="0,0,0,8" /><TextBox Text="{Binding PreviewAfter, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" MinHeight="120" MaxHeight="220" VerticalScrollBarVisibility="Auto" /></StackPanel></Border>
        </Grid>

        <Border Grid.Row="8" Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Önizleme" Command="{Binding PreviewCommand}" Visibility="{Binding SupportsPreview, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,8,0" /><Button Content="İptal" Command="{Binding CancelLatestCommand}" Margin="0,0,8,0" /><Button Content="Çalıştır" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel></Grid></Border>
    </Grid></ScrollViewer>
</UserControl>
