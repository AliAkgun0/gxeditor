<UserControl x:Class="GalaXako.Editor.App.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="İşler" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Uzun işlemlerin gerçek ilerlemesini, hızını ve sonucunu izleyin." Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasJobs}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Henüz iş yok" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,6" />
                    <TextBlock Text="Başlatılan dosya işlemleri burada görünür." Foreground="{StaticResource Brush.Text.Secondary}" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Jobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Operation}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding InputFileName}" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" /></StackPanel>
                                        <Border Grid.Column="1" Background="#211B2E" CornerRadius="8" Padding="10,6"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Brush.Primary.Soft}" /></Border>
                                    </Grid>
                                    <ProgressBar Grid.Row="2" Value="{Binding Percentage, Mode=OneWay}" Maximum="100" />
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding ProgressSummary}" Foreground="{StaticResource Brush.Text.Secondary}" /><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding SpeedText}" Foreground="{StaticResource Brush.Text.Muted}" /><TextBlock Text=" · " Foreground="{StaticResource Brush.Text.Muted}" /><TextBlock Text="{Binding EtaText}" Foreground="{StaticResource Brush.Text.Muted}" /></StackPanel><TextBlock Text="{Binding Error}" Foreground="{StaticResource Brush.Danger}" Margin="0,6,0,0" /></StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="İptal" Command="{Binding CancelCommand}" Margin="0,0,8,0" /><Button Content="Çıktıyı Göster" Command="{Binding OpenOutputFolderCommand}" Margin="0,0,8,0" /><Button Content="Yeniden Dene" Command="{Binding RetryCommand}" Margin="0,0,8,0" /><Button Content="Kaldır" Command="{Binding RemoveCommand}" /></StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
