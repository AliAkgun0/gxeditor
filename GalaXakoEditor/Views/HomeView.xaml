<UserControl x:Class="GalaXako.Editor.App.Views.HomeView" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="GalaXako Editor" Style="{StaticResource PageTitle}" /><TextBlock Text="Büyük metin ve liste dosyaları için hızlı yerel işleme." Style="{StaticResource PageSubtitle}" /></StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" MinHeight="200" BorderBrush="#57418F"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="48" Height="48" Background="#282039" CornerRadius="14" Margin="0,0,0,16"><TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons" FontSize="23" Foreground="{StaticResource Brush.Primary.Soft}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Bir dosyayı buraya bırakın" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="TXT, LOG, CSV, TSV ve JSONL" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,6,0,16" HorizontalAlignment="Center" /><Button Content="Dosya Seç" Style="{StaticResource PrimaryButton}" Command="{Binding OpenFileCommand}" /></StackPanel></Border>
        <StackPanel Grid.Row="4"><TextBlock Text="Son Dosyalar" Style="{StaticResource SectionTitle}" /><Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasRecentFiles}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Henüz son dosya yok. Açtığınız dosyalar yalnızca bu cihazda burada listelenir." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" /></Border><ItemsControl ItemsSource="{Binding RecentFiles}"><ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasRecentFiles}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.OpenRecentCommand, Source={x:Reference Root}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Width="260" Margin="0,0,8,8" Padding="0"><Border Style="{StaticResource Card}" Padding="16"><Border.ContextMenu><ContextMenu><MenuItem Header="Aç" Command="{Binding DataContext.OpenRecentCommand, Source={x:Reference Root}}" CommandParameter="{Binding}" /><MenuItem Header="İçeren klasörü aç" Command="{Binding DataContext.OpenContainingFolderCommand, Source={x:Reference Root}}" CommandParameter="{Binding}" /><MenuItem Header="Yolu kopyala" Command="{Binding DataContext.CopyPathCommand, Source={x:Reference Root}}" CommandParameter="{Binding}" /><Separator /><MenuItem Header="Son dosyalardan kaldır" Command="{Binding DataContext.RemoveRecentCommand, Source={x:Reference Root}}" CommandParameter="{Binding}" /></ContextMenu></Border.ContextMenu><StackPanel><TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" /><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="{Binding FileType}" Foreground="{StaticResource Brush.Primary.Soft}" /><TextBlock Text=" · " Foreground="{StaticResource Brush.Text.Muted}" /><TextBlock Text="{Binding Size, StringFormat={}{0:N0} bayt}" Foreground="{StaticResource Brush.Text.Secondary}" /></StackPanel><TextBlock Text="{Binding LastOpenedUtc, StringFormat={}{0:g}}" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,4,0,0" /></StackPanel></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        <StackPanel Grid.Row="6"><TextBlock Text="Hızlı İşlemler" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" /><UniformGrid Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Temizle" FontWeight="SemiBold" /><TextBlock Text="Boşlukları ve boş satırları düzenleyin." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Tekrarları Kaldır" FontWeight="SemiBold" /><TextBlock Text="Benzersiz satırlar üretin." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,8"><StackPanel><TextBlock Text="Filtrele &amp; Ayıkla" FontWeight="SemiBold" /><TextBlock Text="Kurallarla satır ve değer seçin." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,6,0,0" /></StackPanel></Border></UniformGrid></StackPanel>
        <UniformGrid Grid.Row="8" Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Aktif İşler" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding ActiveJobs}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Bugün İşlenen" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding ProcessedToday, StringFormat={}{0:N0} satır}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Son İşlem" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" /><TextBlock Text="{Binding LastOperation}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" /></StackPanel></Border></UniformGrid>
    </Grid></ScrollViewer>
</UserControl>
