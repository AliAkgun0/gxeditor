<UserControl x:Class="GalaXako.Editor.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ayarlar" Style="{StaticResource PageTitle}" /><TextBlock Text="Genel, görünüm, performans ve dosya tercihleri." Style="{StaticResource PageSubtitle}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" Margin="0,0,14,0" /><Button Content="Ayarları Kaydet" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" /></StackPanel></Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Genel" Style="{StaticResource SectionTitle}" /><CheckBox Content="Son kullanılan dosyayı açılışta yeniden aç" IsChecked="{Binding ReopenLastFile}" /><CheckBox Content="Yıkıcı işlemleri onayla" IsChecked="{Binding ConfirmDestructiveActions}" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Saklanacak son dosya sayısı" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding RecentFileCount}" /></Grid></StackPanel></Border>

            <Border Grid.Row="4" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Görünüm" Style="{StaticResource SectionTitle}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tema" /><TextBlock Text="Koyu veya Windows sistem tercihi." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,4,0,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" /></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock Text="Vurgu rengi" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="GalaXako Purple" Foreground="{StaticResource Brush.Primary.Soft}" VerticalAlignment="Center" /></Grid></StackPanel></Border>

            <Border Grid.Row="6" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Performans" Style="{StaticResource SectionTitle}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Normal / büyük dosya eşiği" /><TextBlock Text="MB; varsayılan 32." Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding ThresholdPresets}" SelectedItem="{Binding ThresholdMb}" /></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock Text="Büyük dosya önizleme satırı" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ChunkPresets}" SelectedItem="{Binding LargeFileChunkLineCount}" /></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock Text="En fazla eşzamanlı batch işi" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrentJobPresets}" SelectedItem="{Binding MaxConcurrentJobs}" /></Grid></StackPanel></Border>

            <Border Grid.Row="8" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dosyalar" Style="{StaticResource SectionTitle}" /><TextBlock Text="Dönüşümler giriş kodlamasını korur; Extract sonuçları taşınabilir UTF-8 üretir." Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,0,10" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><TextBlock Text="Çıktı dosyası eki" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding OutputSuffix}" /></Grid><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="420" /></Grid.ColumnDefinitions><TextBlock Text="Varsayılan çıktı klasörü" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding DefaultOutputFolder}" ToolTip="{Binding DefaultOutputFolder}" /></Grid></StackPanel></Border>

            <Border Grid.Row="10" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hakkında" Style="{StaticResource SectionTitle}" /><TextBlock FontSize="17"><Run Text="GalaXako" FontWeight="SemiBold" /><Run Text=" Editor" Foreground="{StaticResource Brush.Text.Secondary}" /></TextBlock><TextBlock Text="Büyük metin ve liste dosyalarını yerel olarak inceleme, temizleme ve dönüştürme aracı." Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,8,0,0" /><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Brush.Success}" Margin="0,0,8,0" /><TextBlock Text="Tüm işlemler yerel olarak yapılır." Foreground="{StaticResource Brush.Text.Secondary}" /></StackPanel></StackPanel><Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Top" Margin="24,0,0,0"><TextBlock Text="{Binding VersionText}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" /></Border></Grid></Border>
        </Grid>
    </ScrollViewer>
</UserControl>
